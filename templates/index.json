    "faq": {
      "type": "faq",
      "settings": {
        "contact_text": "Still unsure? <a href=\"/pages/contact\">Contact us</a>."
      },
      "blocks": {
        "q0": {
          "type": "question",
          "settings": {
            "question": "What's inside a blind box?",
            "answer": "<p>One sealed box contains one random figure from the Culling Game series: one of the six standard characters or, rarely, the secret figure. You only find out who when you open it.</p>"
          }
        },
        "q1": {
          "type": "question",
          "settings": {
            "question": "Can I choose my character?",
            "answer": "<p>No. Every box is sealed and identical from the outside, which is the whole point of the ritual. If you want more chances at a specific character, bigger formats lower the price per box.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Can I get duplicates?",
            "answer": "<p>Yes. Each box is random, so duplicates are possible, including in the 3-box pack. A 6-box display is a full manufacturer case; we do not guarantee a complete set or the secret figure.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "What are the odds of the secret figure?",
            "answer": "<p>The manufacturer states roughly 1 secret in every 72 boxes. It is never guaranteed, whatever format you buy.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "How much is shipping and how long does it take?",
            "answer": "<p>Every order ships with tracking. Shipping costs and delivery estimates for your address are shown at checkout before you pay.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Can I return my order?",
            "answer": "<p>You have 14 days after delivery to withdraw from your purchase. Unopened boxes are the easiest to return. Full details are in our refund policy.</p>"
          }
        }
      },
