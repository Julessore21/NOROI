{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'head' %}
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <main class="section">
      <div class="container container--narrow center">
        <img src="{{ 'noroi-logo.jpg' | asset_url }}" alt="{{ shop.name }}" width="140" height="140" class="header__logo-img--blend">
        <h1 class="h1 display">{{ gift_card.balance | money }}</h1>
        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="muted">{{ 'gift_card.expired' | t }}</p>
        {%- endif -%}
        {%- if gift_card.expires_on -%}
          {%- assign expires_on = gift_card.expires_on | date: '%B %e, %Y' -%}
          <p class="muted">{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
        {%- endif -%}
        <p>{{ 'gift_card.use_at_checkout' | t }}</p>
        <p class="giftcode">{{ gift_card.code | format_code }}</p>
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" alt="{{ 'gift_card.add_to_apple_wallet' | t }}" width="200" height="60"></a>
        {%- endif -%}
        <p><a class="btn btn--primary" href="{{ shop.url }}">{{ 'cart.continue' | t }}</a></p>
      </div>
    </main>
  </body>
</html>
