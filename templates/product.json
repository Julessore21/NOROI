          "settings": {
            "title": "How blind boxes work",
            "content": "<p>Each box contains one random figure from the series. You can't choose or see the character before opening. Duplicates are possible, and the secret figure (≈ 1 in 72 boxes per the manufacturer) is never guaranteed.</p>"
          }
        },
        "tab1": {
          "type": "tab",
          "settings": {
            "title": "Product details",
            "content": "<ul><li>Series: Jujutsu Kaisen: The Culling Game</li><li>5 standard figures + 1 secret</li><li>Figure size: approx. 8–10 cm</li><li>Material: PVC / ABS</li><li>Not suitable for children under 15</li></ul>"
          }
        },
        "tab2": {
          "type": "tab",
          "settings": {
            "title": "Shipping & returns",
            "content": "<p>Every order ships with tracking. Costs and delivery estimates are shown at checkout. You have 14 days after delivery to withdraw from your purchase.</p>",
