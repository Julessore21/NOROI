<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <script>document.documentElement.className = 'js';</script>
    {% render 'head' %}
    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-link" href="#main">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}

    <script>
      window.noroi = {
        routes: {
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }},
          root: {{ routes.root_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        strings: {
          added: {{ 'products.added' | t | json }},
          error: {{ 'products.error' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          addToCart: {{ 'products.add_to_cart' | t | json }}
        }
      };
    </script>
  </body>
</html>
