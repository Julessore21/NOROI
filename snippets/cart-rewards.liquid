{%- comment -%}
  Box-count rewards progress (theme settings > Cart > Box rewards).
{%- endcomment -%}
{%- liquid
  assign r1 = settings.reward1_boxes
  assign r2 = settings.reward2_boxes
  assign max = r1
  if r2 > max
    assign max = r2
  endif
  assign total_boxes = 0
  for item in cart.items
    capture ib
      render 'box-count', product: item.product
    endcapture
    assign line_boxes = ib | plus: 0 | times: item.quantity
    assign total_boxes = total_boxes | plus: line_boxes
  endfor
-%}
{%- if max > 0 and cart.item_count > 0 -%}
  {%- liquid
    assign next_label = ''
    assign next_needed = 0
    if r1 > 0 and total_boxes < r1
      assign next_label = settings.reward1_label
      assign next_needed = r1 | minus: total_boxes
    elsif r2 > 0 and total_boxes < r2
      assign next_label = settings.reward2_label
      assign next_needed = r2 | minus: total_boxes
    endif
    assign pct = total_boxes | times: 100 | divided_by: max
    if pct > 100
      assign pct = 100
    endif
  -%}
  <div class="rewards">
    <p class="rewards__text">
      {%- if next_needed > 0 -%}
        {{ 'cart.reward_next_html' | t: count: next_needed, reward: next_label }}
      {%- else -%}
        {{ 'cart.reward_done' | t }}
      {%- endif -%}
    </p>
    <div class="rewards__track">
      <span class="rewards__fill" style="width: {{ pct }}%"></span>
      {%- if r1 > 0 -%}
        <span class="rewards__stop{% if total_boxes >= r1 %} is-done{% endif %}" style="left: {{ r1 | times: 100 | divided_by: max }}%">
          <span class="rewards__tip">{{ r1 }} · {{ settings.reward1_label }}</span>
        </span>
      {%- endif -%}
      {%- if r2 > 0 -%}
        <span class="rewards__stop{% if total_boxes >= r2 %} is-done{% endif %}" style="left: {{ r2 | times: 100 | divided_by: max }}%">
          <span class="rewards__tip">{{ r2 }} · {{ settings.reward2_label }}</span>
        </span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
