<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="{{ settings.color_bg }}">
<link rel="canonical" href="{{ canonical_url }}">

{%- if settings.favicon != blank -%}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
{%- else -%}
  <link rel="icon" type="image/png" href="{{ 'noroi-favicon.png' | asset_url }}">
{%- endif -%}

{%- liquid
  assign page_title_full = page_title
  if current_tags
    assign page_title_full = page_title_full | append: ' – ' | append: current_tags | join: ', '
  endif
  if current_page != 1
    assign page_title_full = page_title_full | append: ' – Page ' | append: current_page
  endif
  unless page_title contains shop.name
    assign page_title_full = page_title_full | append: ' | ' | append: shop.name
  endunless
-%}
<title>{{ page_title_full }}</title>
{%- if page_description -%}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif -%}

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_type = 'website'
  assign og_image = 'noroi-hero.jpg' | asset_url | prepend: 'https:'
  if request.page_type == 'product'
    assign og_type = 'product'
  endif
  if page_image
    assign og_image = page_image | image_url: width: 1200 | prepend: 'https:'
  elsif settings.share_image
    assign og_image = settings.share_image | image_url: width: 1200 | prepend: 'https:'
  endif
-%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ page_description | default: shop.description | default: settings.tagline | escape }}">
<meta property="og:image" content="{{ og_image }}">
{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ page_description | default: shop.description | default: settings.tagline | escape }}">

{{ 'unbounded-700.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'satoshi-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

<style>
  @font-face { font-family: 'Unbounded'; font-weight: 700; font-style: normal; font-display: swap; src: url('{{ 'unbounded-700.woff2' | asset_url }}') format('woff2'); }
  @font-face { font-family: 'Satoshi'; font-weight: 400; font-style: normal; font-display: swap; src: url('{{ 'satoshi-400.woff2' | asset_url }}') format('woff2'); }
  @font-face { font-family: 'Satoshi'; font-weight: 500 800; font-style: normal; font-display: swap; src: url('{{ 'satoshi-700.woff2' | asset_url }}') format('woff2'); }

  :root {
    --font: 'Satoshi', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-title: 'Unbounded', 'Satoshi', sans-serif;
    --c-bg: {{ settings.color_bg }};
    --c-surface: {{ settings.color_surface }};
    --c-line: {{ settings.color_line }};
    --c-text: {{ settings.color_text }};
    --c-muted: {{ settings.color_muted }};
    --c-accent: {{ settings.color_accent }};
    --c-accent-rgb: {{ settings.color_accent.red }}, {{ settings.color_accent.green }}, {{ settings.color_accent.blue }};
    --c-aura: {{ settings.color_aura }};
    --c-aura-rgb: {{ settings.color_aura.red }}, {{ settings.color_aura.green }}, {{ settings.color_aura.blue }};
    --c-success: #4fb37a;
  }
</style>

{{ 'noroi.css' | asset_url | stylesheet_tag }}
<script src="{{ 'noroi.js' | asset_url }}" defer></script>
