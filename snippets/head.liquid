<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="{{ settings.color_bg }}">
<link rel="canonical" href="{{ canonical_url }}">

{%- if settings.favicon != blank -%}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
{%- else -%}
  <link rel="icon" type="image/png" href="{{ 'noroi-favicon.png' | asset_url }}">
{%- endif -%}

{%- liquid
  assign page_title_full = page_title
  if current_tags
    assign page_title_full = page_title_full | append: ' – ' | append: current_tags | join: ', '
  endif
  if current_page != 1
    assign page_title_full = page_title_full | append: ' – Page ' | append: current_page
  endif
  unless page_title contains shop.name
    assign page_title_full = page_title_full | append: ' | ' | append: shop.name
  endunless
-%}
<title>{{ page_title_full }}</title>
{%- if page_description -%}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif -%}

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_type = 'website'
  assign og_image = 'noroi-hero.jpg' | asset_url | prepend: 'https:'
  if request.page_type == 'product'
    assign og_type = 'product'
  endif
  if page_image
    assign og_image = page_image | image_url: width: 1200 | prepend: 'https:'
  elsif settings.share_image
    assign og_image = settings.share_image | image_url: width: 1200 | prepend: 'https:'
  endif
-%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ page_description | default: shop.description | default: settings.tagline | escape }}">
<meta property="og:image" content="{{ og_image }}">
{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ page_description | default: shop.description | default: settings.tagline | escape }}">

{{ 'barlow-condensed-800.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'manrope-var.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{%- liquid
  case settings.display_font
    when 'shojumaru'
      assign df_file = 'shojumaru.woff2'
      assign df_name = 'Shojumaru'
      assign df_scale = '1'
      assign df_track = '.015em'
    when 'dela'
      assign df_file = 'dela-gothic-one.woff2'
      assign df_name = 'Dela Gothic One'
      assign df_scale = '.86'
      assign df_track = '0em'
    when 'bangers'
      assign df_file = 'bangers.woff2'
      assign df_name = 'Bangers'
      assign df_scale = '1.3'
      assign df_track = '.03em'
    when 'barlow'
      assign df_file = blank
      assign df_name = 'Barlow Condensed'
      assign df_scale = '1.25'
      assign df_track = '.01em'
    else
      assign df_file = 'knewave.woff2'
      assign df_name = 'Knewave'
      assign df_scale = '1.08'
      assign df_track = '.01em'
  endcase
-%}
{%- if df_file != blank -%}{{ df_file | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}{%- endif %}
{%- liquid
  assign accent_on = false
  if settings.accent_font == 'knewave' and df_name != 'Knewave'
    assign accent_on = true
  endif
-%}
{%- if accent_on -%}{{ 'knewave.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}{%- endif %}

<style>
  @font-face { font-family: 'Barlow Condensed'; font-weight: 600; font-style: normal; font-display: swap; src: url('{{ 'barlow-condensed-600.woff2' | asset_url }}') format('woff2'); }
  @font-face { font-family: 'Barlow Condensed'; font-weight: 800; font-style: normal; font-display: swap; src: url('{{ 'barlow-condensed-800.woff2' | asset_url }}') format('woff2'); }
  {%- if accent_on %}
  @font-face { font-family: 'Knewave'; font-weight: 400; font-style: normal; font-display: swap; src: url('{{ 'knewave.woff2' | asset_url }}') format('woff2'); }
  {%- endif %}
  {%- if df_file != blank %}
  @font-face { font-family: '{{ df_name }}'; font-weight: 400; font-style: normal; font-display: swap; src: url('{{ df_file | asset_url }}') format('woff2'); }
  {%- endif %}
  @font-face { font-family: 'Manrope'; font-weight: 400 700; font-style: normal; font-display: swap; src: url('{{ 'manrope-var.woff2' | asset_url }}') format('woff2'); }

  :root {
    --font-display: '{{ df_name }}', 'Barlow Condensed', Impact, sans-serif;
    --font-accent: {% if accent_on %}'Knewave', {% endif %}var(--font-display);
    --accent-size: {% if accent_on %}calc(1.08em / {{ df_scale }}){% else %}1em{% endif %};
    --display-scale: {{ df_scale }};
    --display-track: {{ df_track }};
    --display-weight: {% if df_name == 'Barlow Condensed' %}800{% else %}400{% endif %};
    --c-bg: {{ settings.color_bg }};
    --c-surface: {{ settings.color_surface }};
    --c-line: {{ settings.color_line }};
    --c-text: {{ settings.color_text }};
    --c-muted: {{ settings.color_muted }};
    --c-accent: {{ settings.color_accent }};
    --c-accent-rgb: {{ settings.color_accent.red }}, {{ settings.color_accent.green }}, {{ settings.color_accent.blue }};
    --c-aura: {{ settings.color_aura }};
    --c-aura-rgb: {{ settings.color_aura.red }}, {{ settings.color_aura.green }}, {{ settings.color_aura.blue }};
    --c-success: #4fb37a;
  }
</style>

{{ 'noroi.css' | asset_url | stylesheet_tag }}
<script src="{{ 'noroi.js' | asset_url }}" defer></script>
