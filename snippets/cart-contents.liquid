{%- comment -%}
  Shared cart markup for the drawer and the cart page.
  Params: context ('drawer' | 'page')
  Every number shown here comes from real prices: per-box price, savings versus
  buying single boxes, and the next format up (smallest format with more boxes).
{%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign formats = collections.all.products | sort: 'price'

  # Price of one box when bought alone (the format with a single box)
  assign single_price = 0
  for p in formats
    capture pb
      render 'box-count', product: p
    endcapture
    assign pb = pb | plus: 0
    if pb == 1 and single_price == 0
      assign single_price = p.price
    endif
  endfor

  assign cart_boxes = 0
  assign max_boxes = 0
  for item in cart.items
    capture ib
      render 'box-count', product: item.product
    endcapture
    assign ib = ib | plus: 0
    assign cart_boxes = ib | times: item.quantity | plus: cart_boxes
    if ib > max_boxes
      assign max_boxes = ib
    endif
  endfor

  assign savings = 0
  if single_price > 0
    assign savings = single_price | times: cart_boxes | minus: cart.total_price
  endif

  # Next format up: the cheapest product holding more boxes than anything in the bag
  assign next = blank
  assign next_boxes = 0
  for p in formats
    capture nb
      render 'box-count', product: p
    endcapture
    assign nb = nb | plus: 0
    if nb > max_boxes and p.available and next == blank
      assign next = p
      assign next_boxes = nb
    endif
  endfor
-%}

<div class="cart{% if cart.item_count == 0 %} cart--empty{% endif %}" data-cart-contents>
  {%- render 'cart-rewards' -%}
  {%- if threshold > 0 and cart.item_count > 0 -%}
    {%- liquid
      assign remaining = threshold | minus: cart.total_price
      assign pct = cart.total_price | times: 100 | divided_by: threshold
      if pct > 100
        assign pct = 100
      endif
    -%}
    <div class="ship-bar{% if remaining <= 0 %} is-done{% endif %}">
      <p class="ship-bar__text">
        {%- if remaining > 0 -%}
          {%- assign remaining_money = remaining | money -%}
          {{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money }}
        {%- else -%}
          {{ 'cart.free_shipping_unlocked' | t }}
        {%- endif -%}
      </p>
      <div class="ship-bar__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}">
        <span style="width: {{ pct }}%"></span>
      </div>
    </div>
  {%- endif -%}

  {%- if cart.item_count == 0 -%}
    <div class="cart__empty">
      <div class="cart__empty-box" aria-hidden="true"><span>?</span></div>
      <p class="cart__empty-title">{{ 'cart.empty' | t }}</p>
      <p class="cart__empty-sub">{{ 'cart.empty_sub' | t }}</p>
    </div>
    <p class="cart__section-label">{{ 'cart.pick_format' | t }}</p>
    <ul class="cart__formats" role="list">
      {%- for p in formats -%}
        {%- liquid
          capture fb
            render 'box-count', product: p
          endcapture
          assign fb = fb | plus: 0
          assign f_per = p.price | divided_by: fb | money
        -%}
        <li class="mini">
          <a class="mini__media" href="{{ p.url }}" tabindex="-1">
            {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', width: 72, height: 72 }}{%- endif -%}
            <span class="mini__count">×{{ fb }}</span>
          </a>
          <div class="mini__info">
            <a class="mini__title" href="{{ p.url }}">{{ 'products.boxes_count' | t: count: fb }}</a>
            <p class="mini__price">{{ p.price | money }}{% if fb > 1 %} <span>· {{ 'products.per_box' | t: price: f_per }}</span>{% endif %}</p>
          </div>
          {%- if p.available -%}
            <button type="button" class="mini__add" data-quick-add="{{ p.selected_or_first_available_variant.id }}" aria-label="{{ 'products.add_to_cart' | t }}: {{ p.title | escape }}">{% render 'icon', name: 'plus' %}</button>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <ul class="cart__items" role="list">
      {%- for item in cart.items -%}
        {%- liquid
          capture lb
            render 'box-count', product: item.product
          endcapture
          assign lb = lb | plus: 0
          assign l_per = item.final_price | divided_by: lb | money
        -%}
        <li class="line" data-line="{{ forloop.index }}" style="--i: {{ forloop.index0 }}">
          <a class="line__media" href="{{ item.url }}" tabindex="-1">
            {%- if item.image -%}
              {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.title, width: 104, height: 104 }}
            {%- endif -%}
            <span class="line__count">×{{ lb }}</span>
          </a>
          <div class="line__info">
            <p class="line__eyebrow">
              {%- if lb > 1 -%}{{ 'products.boxes_count' | t: count: lb }} · {{ 'products.per_box' | t: price: l_per }}{%- else -%}{{ 'products.single_box' | t }}{%- endif -%}
            </p>
            <a class="line__title" href="{{ item.url }}">{{ item.product.title }}</a>
            {%- if item.product.variants.size > 1 -%}
              <p class="line__variant">{{ item.variant.title }}</p>
            {%- endif -%}
            {%- for d in item.line_level_discount_allocations -%}
              <p class="line__discount">{{ d.discount_application.title }} (−{{ d.amount | money }})</p>
            {%- endfor -%}
            <div class="line__row">
              <div class="stepper">
                <button type="button" class="stepper__btn" data-qty-change="{{ item.quantity | minus: 1 }}" aria-label="{{ 'cart.decrease' | t: title: item.product.title }}">{% render 'icon', name: 'minus' %}</button>
                <span class="stepper__val" aria-live="polite">{{ item.quantity }}</span>
                <button type="button" class="stepper__btn" data-qty-change="{{ item.quantity | plus: 1 }}" aria-label="{{ 'cart.increase' | t: title: item.product.title }}">{% render 'icon', name: 'plus' %}</button>
              </div>
              <div class="line__price">
                {%- if item.original_line_price != item.final_line_price -%}
                  <s>{{ item.original_line_price | money }}</s>
                {%- endif -%}
                <span>{{ item.final_line_price | money }}</span>
              </div>
            </div>
          </div>
          <button type="button" class="line__remove" data-qty-change="0" aria-label="{{ 'cart.remove' | t }}: {{ item.product.title | escape }}">{% render 'icon', name: 'close' %}</button>
        </li>
      {%- endfor -%}
    </ul>

    {%- if next != blank -%}
      {%- liquid
        assign next_per_cents = next.price | divided_by: next_boxes
        assign next_per = next_per_cents | money
        assign next_save = 0
        if single_price > 0
          assign ratio = next_per_cents | times: 100 | divided_by: single_price
          assign next_save = 100 | minus: ratio | round
        endif
      -%}
      <div class="levelup">
        <div class="levelup__media">
          {%- if next.featured_media -%}{{ next.featured_media | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', width: 64, height: 64 }}{%- endif -%}
          <span class="levelup__count">×{{ next_boxes }}</span>
        </div>
        <div class="levelup__info">
          <p class="levelup__label">{{ 'cart.level_up' | t }}</p>
          <p class="levelup__title">{{ 'products.boxes_count' | t: count: next_boxes }} · {{ next.price | money }}</p>
          <p class="levelup__sub">
            {{ 'products.per_box' | t: price: next_per }}
            {%- if next_save > 0 %} · <strong>{{ 'products.save_per_box' | t: pct: next_save }}</strong>{%- endif -%}
          </p>
        </div>
        <button type="button" class="levelup__add" data-quick-add="{{ next.selected_or_first_available_variant.id }}">{{ 'products.add' | t }}</button>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{%- if cart.item_count > 0 -%}
  <div class="cart__footer">
    {%- if context == 'page' -%}<p class="cart__summary-title">{{ 'cart.summary' | t }}</p>{%- endif -%}
    <div class="cart__lines">
      <p class="cart__row"><span>{{ 'cart.boxes' | t: count: cart_boxes }}</span><span>{{ cart.items_subtotal_price | money }}</span></p>
      {%- for d in cart.cart_level_discount_applications -%}
        <p class="cart__row cart__row--save"><span>{{ d.title }}</span><span>−{{ d.total_allocated_amount | money }}</span></p>
      {%- endfor -%}
      {%- if savings > 0 -%}
        <p class="cart__row cart__row--save"><span>{{ 'cart.savings_vs_single' | t }}</span><span>{{ savings | money }}</span></p>
      {%- endif -%}
      <p class="cart__row cart__row--muted"><span>{{ 'cart.shipping' | t }}</span><span>{{ 'cart.shipping_at_checkout' | t }}</span></p>
    </div>
    <p class="cart__row cart__total"><span>{{ 'cart.total' | t }}</span><span>{{ cart.total_price | money_with_currency }}</span></p>
    <p class="cart__tax">{%- if cart.taxes_included -%}{{ 'cart.taxes_included_short' | t }}{%- else -%}{{ 'cart.taxes_excluded' | t }}{%- endif -%}</p>
    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="btn btn--primary btn--block btn--lg cart__checkout">
        {% render 'icon', name: 'lock' %} {{ 'cart.checkout' | t }}
      </button>
    </form>
    {%- if additional_checkout_buttons and context == 'page' -%}
      <div class="cart__dynamic">{{ content_for_additional_checkout_buttons }}</div>
    {%- endif -%}
    <ul class="pay-icons" role="list">
      {%- for type in shop.enabled_payment_types -%}
        <li>{{ type | payment_type_svg_tag }}</li>
      {%- endfor -%}
    </ul>
    <ul class="cart__trust" role="list">
      <li>{% render 'icon', name: 'box' %} {{ 'cart.trust_sealed_short' | t }}</li>
      <li>{% render 'icon', name: 'truck' %} {{ 'cart.trust_tracked_short' | t }}</li>
      <li>{% render 'icon', name: 'return' %} {{ 'cart.trust_returns_short' | t }}</li>
    </ul>
    {%- if context == 'page' -%}
      <a class="cart__keep" href="{{ routes.all_products_collection_url }}">{{ 'cart.keep_shopping' | t }}</a>
    {%- endif -%}
  </div>
{%- endif -%}
