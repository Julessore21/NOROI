{%- comment -%}
  Shared cart markup for the drawer and the cart page.
  Params: context ('drawer' | 'page')
{%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign upsell = settings.cart_upsell_product
  assign upsell_in_cart = false
  assign cart_boxes = 0
  for item in cart.items
    capture ib
      render 'box-count', product: item.product
    endcapture
    assign cart_boxes = ib | plus: 0 | times: item.quantity | plus: cart_boxes
    if upsell and item.product_id == upsell.id
      assign upsell_in_cart = true
    endif
  endfor
-%}

<div class="cart" data-cart-contents>
  {%- render 'cart-rewards' -%}
  {%- if threshold > 0 and cart.item_count > 0 -%}
    {%- liquid
      assign remaining = threshold | minus: cart.total_price
      assign pct = cart.total_price | times: 100 | divided_by: threshold
      if pct > 100
        assign pct = 100
      endif
    -%}
    <div class="ship-bar{% if remaining <= 0 %} is-done{% endif %}">
      <p class="ship-bar__text">
        {%- if remaining > 0 -%}
          {%- assign remaining_money = remaining | money -%}
          {{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money }}
        {%- else -%}
          {{ 'cart.free_shipping_unlocked' | t }}
        {%- endif -%}
      </p>
      <div class="ship-bar__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}">
        <span style="width: {{ pct }}%"></span>
      </div>
    </div>
  {%- endif -%}

  {%- if cart.item_count == 0 -%}
    <div class="cart__empty">
      <span class="cart__empty-glyph" aria-hidden="true">呪</span>
      <p class="h3">{{ 'cart.empty' | t }}</p>
      <p class="muted">{{ 'cart.empty_sub' | t }}</p>
      <a class="btn btn--primary" href="{{ settings.cart_empty_link | default: routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
    </div>
  {%- else -%}
    <ul class="cart__items" role="list">
      {%- for item in cart.items -%}
        <li class="line" data-line="{{ forloop.index }}">
          <a class="line__media" href="{{ item.url }}" tabindex="-1">
            {%- if item.image -%}
              {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.title, width: 100, height: 100 }}
            {%- endif -%}
          </a>
          <div class="line__info">
            <a class="line__title" href="{{ item.url }}">{{ item.product.title }}</a>
            {%- if item.product.variants.size > 1 -%}
              <p class="line__variant muted">{{ item.variant.title }}</p>
            {%- endif -%}
            {%- for d in item.line_level_discount_allocations -%}
              <p class="line__discount">{{ d.discount_application.title }} (−{{ d.amount | money }})</p>
            {%- endfor -%}
            <div class="line__row">
              <div class="qty qty--sm">
                <button type="button" class="qty__btn" data-qty-change="{{ item.quantity | minus: 1 }}" aria-label="{{ 'cart.decrease' | t: title: item.product.title }}">{% render 'icon', name: 'minus' %}</button>
                <span class="qty__val" aria-live="polite">{{ item.quantity }}</span>
                <button type="button" class="qty__btn" data-qty-change="{{ item.quantity | plus: 1 }}" aria-label="{{ 'cart.increase' | t: title: item.product.title }}">{% render 'icon', name: 'plus' %}</button>
              </div>
              <div class="line__price">
                {%- if item.original_line_price != item.final_line_price -%}
                  <s class="muted">{{ item.original_line_price | money }}</s>
                {%- endif -%}
                <span>{{ item.final_line_price | money }}</span>
              </div>
            </div>
            <button type="button" class="line__remove link-muted" data-qty-change="0">{{ 'cart.remove' | t }}</button>
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {%- if upsell and upsell.available and upsell_in_cart == false -%}
      {%- capture up_boxes -%}{% render 'box-count', product: upsell %}{%- endcapture -%}
      {%- assign up_boxes = up_boxes | plus: 0 -%}
      <div class="upsell">
        <p class="eyebrow">{{ settings.cart_upsell_heading }}</p>
        <div class="upsell__card">
          {%- if upsell.featured_image -%}
            {{ upsell.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: upsell.title, width: 72, height: 72 }}
          {%- endif -%}
          <div class="upsell__info">
            <p class="upsell__title">{{ upsell.title }}</p>
            <p class="muted small">
              {{ upsell.price | money }}
              {%- if up_boxes > 1 -%}
                {%- assign up_per = upsell.price | divided_by: up_boxes | money %} · {{ 'products.per_box' | t: price: up_per }}
              {%- endif -%}
            </p>
          </div>
          <button type="button" class="btn btn--ghost btn--sm" data-quick-add="{{ upsell.selected_or_first_available_variant.id }}">{{ 'products.add' | t }}</button>
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{%- if cart.item_count > 0 -%}
  <div class="cart__footer">
    {%- if context == 'page' -%}<p class="cart__summary-title">{{ 'cart.summary' | t }}</p>{%- endif -%}
    {%- if cart_boxes > 0 -%}
      {%- assign avg_box = cart.total_price | divided_by: cart_boxes | money -%}
      <p class="cart__row cart__boxes small"><span>{% render 'icon', name: 'box' %} {{ 'cart.boxes' | t: count: cart_boxes }}</span><span>{{ 'products.per_box' | t: price: avg_box }}</span></p>
    {%- endif -%}
    {%- if cart.cart_level_discount_applications.size > 0 -%}
      {%- for d in cart.cart_level_discount_applications -%}
        <p class="cart__row small"><span>{{ d.title }}</span><span>−{{ d.total_allocated_amount | money }}</span></p>
      {%- endfor -%}
    {%- endif -%}
    <p class="cart__row cart__total"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money_with_currency }}</span></p>
    <p class="muted small">
      {%- if cart.taxes_included -%}{{ 'cart.taxes_included' | t }}{%- else -%}{{ 'cart.taxes_excluded' | t }}{%- endif -%}
    </p>
    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="btn btn--primary btn--block btn--lg">
        {% render 'icon', name: 'lock' %} {{ 'cart.checkout' | t }}
      </button>
    </form>
    {%- if additional_checkout_buttons and context == 'page' -%}
      <div class="cart__dynamic">{{ content_for_additional_checkout_buttons }}</div>
    {%- endif -%}
    <ul class="pay-icons" role="list">
      {%- for type in shop.enabled_payment_types -%}
        <li>{{ type | payment_type_svg_tag }}</li>
      {%- endfor -%}
    </ul>
    <ul class="cart__trust" role="list">
      <li>{% render 'icon', name: 'box' %} {{ 'cart.trust_sealed' | t }}</li>
      <li>{% render 'icon', name: 'truck' %} {{ 'cart.trust_tracked' | t }}</li>
      <li>{% render 'icon', name: 'return' %} {{ 'cart.trust_returns' | t }}</li>
    </ul>
    {%- if context == 'page' -%}
      <a class="cart__keep link-muted" href="{{ routes.all_products_collection_url }}">← {{ 'cart.keep_shopping' | t }}</a>
    {%- endif -%}
  </div>
{%- endif -%}
