{%- comment -%}
  Usage: {% render 'icon', name: 'cart' %}
{%- endcomment -%}
<svg class="icon icon--{{ name }}" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {%- case name -%}
    {%- when 'cart' -%}
