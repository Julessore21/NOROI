<footer class="footer">
  <div class="container container--wide">
    <div class="footer__grid">
      <div class="footer__brand">
        <img src="{{ 'noroi-logo.jpg' | asset_url }}" alt="{{ shop.name }}" width="96" height="96" loading="lazy" class="header__logo-img--blend">
        <p class="footer__tagline">{{ settings.tagline }}</p>
        <div class="footer__social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" class="icon-btn" aria-label="Instagram" rel="noopener" target="_blank">{% render 'icon', name: 'instagram' %}</a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" class="icon-btn" aria-label="TikTok" rel="noopener" target="_blank">{% render 'icon', name: 'tiktok' %}</a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.settings.menu.links.size == 0 -%}{%- continue -%}{%- endif -%}
        <div class="footer__col" {{ block.shopify_attributes }}>
          <p class="eyebrow">{{ block.settings.heading }}</p>
          <ul role="list">
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}

      <div class="footer__col">
        <p class="eyebrow">{{ 'footer.legal' | t }}</p>
        <ul role="list">
          {%- for policy in shop.policies -%}
            {%- comment -%} Skip policies a footer menu already links to {%- endcomment -%}
            {%- assign in_menu = false -%}
            {%- for block in section.blocks -%}
              {%- for link in block.settings.menu.links -%}
                {%- if link.url == policy.url -%}{%- assign in_menu = true -%}{%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
            {%- unless in_menu -%}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endunless -%}
          {%- endfor -%}
          {%- if shop.customer_accounts_enabled -%}
            <li><a href="{{ routes.account_url }}">{{ 'footer.account' | t }}</a></li>
          {%- endif -%}
        </ul>
      </div>
    </div>

    {%- if section.settings.disclaimer != blank -%}
      <p class="footer__disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}

    <div class="footer__bottom">
      <p class="small muted">&copy; {{ 'now' | date: '%Y' }} {{ settings.brand_name | default: shop.name }}. {{ 'footer.rights' | t }}</p>
      <ul class="pay-icons" role="list">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag }}</li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 3,
  "settings": [
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Independence disclaimer",
      "default": "NOROI est un revendeur indépendant. Nous ne sommes ni affiliés, ni approuvés, ni sponsorisés par les marques ou ayants droit des produits que nous vendons. Les marques et personnages appartiennent à leurs propriétaires respectifs."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Boutique" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
