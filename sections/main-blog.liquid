<section class="section">
  <div class="container">
    <div class="section-head"><h1 class="h1 display">{{ blog.title }}</h1></div>
    {%- paginate blog.articles by 9 -%}
      <div class="grid grid--3">
        {%- for article in blog.articles -%}
          <a class="tile" href="{{ article.url }}">
            {%- if article.image -%}
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.title }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
            <span class="tile__title">{{ article.title }}</span>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
