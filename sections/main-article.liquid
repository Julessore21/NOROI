<article class="section">
  <div class="container container--narrow">
    <p class="eyebrow eyebrow--accent">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h1 class="h1 display page-title">{{ article.title }}</h1>
    {%- if article.image -%}
      <div class="article__image">{{ article.image | image_url: width: 1400 | image_tag: widths: '700, 1000, 1400', sizes: '(min-width: 800px) 760px, 100vw', alt: article.title }}</div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
  </div>
</article>

{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
