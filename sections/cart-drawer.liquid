<cart-drawer class="drawer" id="CartDrawer" aria-hidden="true">
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1">
    <div class="drawer__head">
      <p class="drawer__title h4" id="CartDrawerTitle">
        {{ 'cart.title' | t }} <span class="muted">({{ cart.item_count }})</span>
      </p>
      <button type="button" class="icon-btn" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="drawer__body">
      {% render 'cart-contents', context: 'drawer' %}
    </div>
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
