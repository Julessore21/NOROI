<section class="pw">
  <div class="pw__bg" aria-hidden="true">
    <img src="{{ 'noroi-hero.jpg' | asset_url }}" alt="" width="1672" height="941">
  </div>
  <div class="pw__inner container container--narrow center">
    <img src="{{ 'noroi-logo.jpg' | asset_url }}" alt="{{ shop.name }}" width="180" height="180" class="header__logo-img--blend pw__logo">
    <p class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</p>
    <h1 class="h1 display">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}

    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
      {%- if form.posted_successfully? -%}
        <p class="form-msg form-msg--ok" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter__field">
          <label for="PwEmail" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
          <input id="PwEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.email' | t }}">
          <button type="submit" class="btn btn--primary">{{ section.settings.button }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details class="pw__login">
      <summary class="small muted">{{ 'password.owner' | t }}</summary>
      {%- form 'storefront_password' -%}
        <div class="newsletter__field">
          <label for="PwPass" class="visually-hidden">{{ 'password.password' | t }}</label>
          <input id="PwPass" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
          <button type="submit" class="btn btn--ghost">{{ 'password.enter' | t }}</button>
        </div>
        {%- if form.errors -%}<p class="form-msg form-msg--err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drop 001 · Coming soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The seal hasn't broken yet." },
    { "type": "text", "id": "button", "label": "Button", "default": "Notify me" }
  ]
}
{% endschema %}
