{%- comment -%}
  Reviews & pulls. Shows only real content:
  - app blocks from a reviews app (Judge.me, Shopify Product Reviews, etc.)
  - "pull" blocks: real customer unboxing photos added by the merchant
  When empty, it invites the first buyers to share instead of faking social proof.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign pull_count = 0
  for block in section.blocks
    if block.type == 'pull'
      assign pull_count = pull_count | plus: 1
    endif
  endfor
-%}
<section class="section community" id="{{ s.anchor | default: 'reviews' }}">
  <div class="container container--wide">
    <div class="section-head reveal">
      {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--accent">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="h1 display">{{ s.heading | replace: '[', '<em>' | replace: ']', '</em>' }}</h2>
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div class="community__app">{% render block %}</div>
      {%- endif -%}
    {%- endfor -%}

    {%- if pull_count > 0 -%}
      <ul class="pulls" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'pull' and block.settings.image != blank or block.type == 'pull' and block.settings.fallback != blank -%}
            {%- liquid
              assign pull_alt = 'community.pulled' | t
              if block.settings.figure != blank
                assign pull_alt = pull_alt | append: ' : ' | append: block.settings.figure
              endif
              if block.settings.image != blank and block.settings.image.alt != blank
                assign pull_alt = block.settings.image.alt
              endif
              assign pull_alt = pull_alt | strip_html
            -%}
            <li class="pull reveal" style="--d: {{ forloop.index0 | times: 90 }}ms; --tilt: {% cycle '-2.4deg', '1.6deg', '-1.2deg', '2.2deg' %}" {{ block.shopify_attributes }}>
              <figure class="pull__card">
                <div class="pull__media">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 990px) 22vw, 75vw', alt: pull_alt }}
                  {%- else -%}
                    <img src="{{ block.settings.fallback | asset_url }}" alt="{{ pull_alt | escape }}" loading="lazy" width="900" height="1125">
                  {%- endif -%}
                  {%- if block.settings.secret -%}<span class="badge badge--accent">{{ 'general.secret' | t }}</span>{%- endif -%}
                  <span class="pull__shine" aria-hidden="true"></span>
                </div>
                <figcaption class="pull__caption">
                  <span class="pull__text">
                    <span class="pull__label">{{ 'community.pulled' | t }}</span>
                    <span class="pull__figure">{{ block.settings.figure }}</span>
                  </span>
                  <span class="pull__stamp" aria-hidden="true">呪</span>
                </figcaption>
                {%- if block.settings.quote != blank -%}<p class="pull__quote">“{{ block.settings.quote }}”</p>{%- endif -%}
                {%- if block.settings.handle != blank -%}<p class="pull__handle">{{ block.settings.handle }}</p>{%- endif -%}
              </figure>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if s.social_handle != blank -%}
        <p class="pulls__cta reveal">{{ 'community.tag_html' | t: handle: s.social_handle }}</p>
      {%- endif -%}
    {%- endif -%}

    {%- if pull_count == 0 and s.show_empty -%}
      <div class="community__empty reveal">
        <span class="community__glyph" aria-hidden="true">呪</span>
        <p class="h3">{{ s.empty_title }}</p>
        <p class="muted">{{ s.empty_text }}</p>
        {%- if s.social_handle != blank -%}
          <p class="community__handle">{{ s.social_handle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Reviews & pulls",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "reviews" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Community pulls" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Who [did they pull?]" },
    { "type": "checkbox", "id": "show_empty", "label": "Show invitation when there are no pulls yet", "default": true },
    { "type": "text", "id": "empty_title", "label": "Empty title", "default": "Your pull could be first." },
    { "type": "textarea", "id": "empty_text", "label": "Empty text", "default": "We've just opened the doors. Film your unboxing, tag us, and your pull gets featured here." },
    { "type": "text", "id": "social_handle", "label": "Social handle", "default": "@noroi" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "pull",
      "name": "Customer pull",
      "settings": [
        { "type": "paragraph", "content": "Only use real customer photos, with their permission." },
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "fallback", "label": "Built-in photo file", "info": "Theme asset used when no photo is picked." },
        { "type": "text", "id": "figure", "label": "Figure pulled" },
        { "type": "checkbox", "id": "secret", "label": "It's the secret", "default": false },
        { "type": "text", "id": "quote", "label": "Customer quote" },
        { "type": "text", "id": "handle", "label": "Customer name or @handle" }
      ]
    }
  ],
  "presets": [{ "name": "Reviews & pulls" }]
}
{% endschema %}
