{%- comment -%}
  Reviews & pulls. Shows only real content:
  - app blocks from a reviews app (Judge.me, Shopify Product Reviews, etc.)
  - "pull" blocks: real customer unboxing photos added by the merchant
  When empty, it invites the first buyers to share instead of faking social proof.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign pull_count = 0
  for block in section.blocks
    if block.type == 'pull'
      assign pull_count = pull_count | plus: 1
    endif
  endfor
-%}
<section class="section community" id="{{ s.anchor | default: 'reviews' }}">
  <div class="container container--wide">
    <div class="section-head reveal">
      {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--accent">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="h1 display">{{ s.heading | replace: '[', '<em>' | replace: ']', '</em>' }}</h2>
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div class="community__app">{% render block %}</div>
      {%- endif -%}
    {%- endfor -%}

    {%- if pull_count > 0 -%}
      <ul class="pulls" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'pull' and block.settings.image != blank -%}
            <li class="pull reveal" style="--d: {{ forloop.index0 | times: 60 }}ms" {{ block.shopify_attributes }}>
              <div class="pull__media">
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 50vw', alt: block.settings.figure }}
                {%- if block.settings.figure != blank -%}<span class="badge{% if block.settings.secret %} badge--accent{% endif %}">{{ block.settings.figure }}</span>{%- endif -%}
              </div>
              {%- if block.settings.quote != blank -%}<p class="pull__quote">“{{ block.settings.quote }}”</p>{%- endif -%}
              {%- if block.settings.handle != blank -%}<p class="pull__handle muted small">{{ block.settings.handle }}</p>{%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if pull_count == 0 and s.show_empty -%}
      <div class="community__empty reveal">
        <span class="community__glyph" aria-hidden="true">呪</span>
        <p class="h3">{{ s.empty_title }}</p>
        <p class="muted">{{ s.empty_text }}</p>
        {%- if s.social_handle != blank -%}
          <p class="community__handle">{{ s.social_handle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Reviews & pulls",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "reviews" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Community pulls" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Who [did they pull?]" },
    { "type": "checkbox", "id": "show_empty", "label": "Show invitation when there are no pulls yet", "default": true },
    { "type": "text", "id": "empty_title", "label": "Empty title", "default": "Your pull could be first." },
    { "type": "textarea", "id": "empty_text", "label": "Empty text", "default": "We've just opened the doors. Film your unboxing, tag us, and your pull gets featured here." },
    { "type": "text", "id": "social_handle", "label": "Social handle", "default": "@noroi" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "pull",
      "name": "Customer pull",
      "settings": [
        { "type": "paragraph", "content": "Only use real customer photos, with their permission." },
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "figure", "label": "Figure pulled" },
        { "type": "checkbox", "id": "secret", "label": "It's the secret", "default": false },
        { "type": "text", "id": "quote", "label": "Customer quote" },
        { "type": "text", "id": "handle", "label": "Customer name or @handle" }
      ]
    }
  ],
  "presets": [{ "name": "Reviews & pulls" }]
}
{% endschema %}
