<section class="section faq" data-scheme="{{ section.settings.scheme }}" id="{{ section.settings.anchor | default: 'faq' }}">
  <div class="container container--narrow">
    <div class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h1 display">{{ section.settings.heading | replace: '[', '<em>' | replace: ']', '</em>' }}</h2>
    </div>
    <div class="accordion">
      {%- for block in section.blocks -%}
        <details class="accordion__item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }} {% render 'icon', name: 'plus' %}</summary>
          <div class="accordion__body rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
    {%- if section.settings.contact_text != blank -%}
      <p class="faq__contact muted">{{ section.settings.contact_text }}</p>
    {%- endif -%}
  </div>
</section>

{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Color scheme", "default": "dark", "options": [
      { "value": "dark", "label": "Dark" },
      { "value": "light", "label": "Light (ivory)" }
    ] },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "faq" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Before you open" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions" },
    { "type": "inline_richtext", "id": "contact_text", "label": "Contact line", "default": "Still unsure? <a href=\"/pages/contact\">Contact us</a>. We answer within 24 hours on business days." }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
