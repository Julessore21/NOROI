<section class="section newsletter">
  <div class="container container--narrow newsletter__inner reveal">
    <span class="newsletter__glyph" aria-hidden="true">呪</span>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="h1 display">{{ section.settings.heading | replace: '[', '<em>' | replace: ']', '</em>' }}</h2>
    {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text }}</p>{%- endif -%}

    {%- form 'customer', class: 'newsletter__form', id: 'NewsletterForm' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-msg form-msg--ok" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter__field">
          <label for="NewsletterEmail" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
          <input id="NewsletterEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.email' | t }}">
          <button type="submit" class="btn btn--primary">{{ section.settings.button }}</button>
        </div>
        {%- if form.errors -%}
          <p class="form-msg form-msg--err" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
    {%- if section.settings.legal != blank -%}<p class="small muted">{{ section.settings.legal }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drop alerts" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Be first when the next curse drops." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Restocks, new series and early access. One email per drop, nothing else." },
    { "type": "text", "id": "button", "label": "Button", "default": "Notify me" },
    { "type": "text", "id": "legal", "label": "Consent note", "default": "Unsubscribe anytime. See our privacy policy." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
