{%- assign items = section.settings.text | split: '|' -%}
<div class="marquee{% if section.settings.accent %} marquee--accent{% endif %}" aria-hidden="true">
  <div class="marquee__track">
    {%- for i in (1..4) -%}
      {%- for t in items -%}
        <span>{{ t | strip }}</span><span class="marquee__sep">呪</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "settings": [
    { "type": "text", "id": "text", "label": "Words", "info": "Separate with |", "default": "Collect the unknown | Drop 001 | The Culling Game | Five figures | One secret" },
    { "type": "checkbox", "id": "accent", "label": "Crimson background", "default": false }
  ],
  "presets": [{ "name": "Marquee" }]
}
{% endschema %}
