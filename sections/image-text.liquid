{%- assign s = section.settings -%}
{%- liquid
  assign media_alt = s.heading | strip_html
  if s.image != blank and s.image.alt != blank
    assign media_alt = s.image.alt
  endif
-%}
<section class="section split split--{{ s.layout }}{% if s.aura %} split--aura{% endif %}" {% if s.anchor != blank %}id="{{ s.anchor }}"{% endif %}>
  <div class="container container--wide split__grid">
    <div class="split__media reveal">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: media_alt }}
      {%- elsif s.fallback != blank -%}
        <img src="{{ s.fallback | asset_url }}" alt="{{ media_alt | escape }}" loading="lazy" width="1100" height="1100">
      {%- else -%}
        <div class="split__veil" aria-hidden="true"><span>?</span></div>
      {%- endif -%}
      {%- if s.caption != blank -%}<p class="split__caption">{{ s.caption }}</p>{%- endif -%}
    </div>
    <div class="split__copy reveal" style="--d: 120ms">
      {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--accent">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="h1 display">{{ s.heading | replace: '[', '<em>' | replace: ']', '</em>' }}</h2>
      {%- if s.text != blank -%}<div class="rte">{{ s.text }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <dl class="facts">
          {%- for block in section.blocks -%}
            <div class="facts__row" {{ block.shopify_attributes }}>
              <dt>{{ block.settings.label }}</dt>
              <dd>{{ block.settings.value }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
      {%- if s.cta_label != blank -%}
        <a class="btn btn--primary btn--lg" href="{{ s.cta_link }}">{{ s.cta_label }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id" },
    { "type": "select", "id": "layout", "label": "Image position", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "checkbox", "id": "aura", "label": "Blue mystery aura", "default": false },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback", "label": "Built-in image file", "info": "Theme asset used when no image is picked. Empty = mystery card." },
    { "type": "text", "id": "caption", "label": "Image caption" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "value", "label": "Value" }
      ]
    }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
