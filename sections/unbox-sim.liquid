{%- comment -%}
  Unboxing simulator: a playful, clearly-labelled simulation of opening one blind box.
  Odds come from the section settings (secret odds = 1 in N, standard figures share the rest).
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="section sim" id="{{ s.anchor | default: 'try' }}">
  <div class="container">
    <div class="section-head reveal">
      {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--accent">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="h1 display">{{ s.heading | replace: '[', '<em>' | replace: ']', '</em>' }}</h2>
      {%- if s.text != blank -%}<p class="section-head__text">{{ s.text }}</p>{%- endif -%}
    </div>

    {%- assign brand = settings.brand_name | default: shop.name | upcase -%}
    <unbox-sim class="sim__stage" data-secret-odds="{{ s.secret_odds }}" style="--box-art: url('{{ s.box_art | default: 'noroi-secret.jpg' | asset_url }}')">
      <div class="sim__arena" role="button" tabindex="0" aria-label="{{ s.button | escape }}" data-sim-open>
        <div class="sim__aura"></div>
        <div class="sim__rays"></div>
        <div class="sim__box" data-sim-box>
          {%- capture face -%}
            <span class="sim__frame"></span>
            <span class="sim__top-band"><b>{{ brand }}</b><i>呪</i></span>
            <span class="sim__window"><span class="sim__window-q">?</span></span>
            <span class="sim__series">{{ s.box_series }}</span>
            <span class="sim__meta">{{ 'sim.inside' | t }}</span>
            <span class="sim__foil">?</span>
            <span class="sim__holo"></span>
          {%- endcapture -%}
          <div class="sim__lidwrap"><div class="sim__lid"><span class="sim__lid-kanji">呪</span><span class="sim__seal">{{ 'sim.sealed' | t }}</span></div></div>
          <div class="sim__sidewrap"><div class="sim__side"><span>{{ 'sim.side' | t }}</span></div></div>
          <div class="sim__half sim__half--l"><div class="sim__face">{{ face }}</div></div>
          <div class="sim__half sim__half--r"><div class="sim__face">{{ face }}</div></div>
          <div class="sim__seam"></div>
        </div>
        <div class="sim__burst" data-sim-burst></div>
        <div class="sim__flash"></div>
      </div>

      <div class="sim__result" data-sim-result hidden>
        <div class="sim__card" data-sim-card>
          <div class="sim__card-inner">
            <div class="sim__card-back"><span>呪</span></div>
            <div class="sim__card-front">
              <div class="sim__card-media" data-sim-media></div>
              <p class="sim__rarity" data-sim-rarity></p>
              <p class="sim__name" data-sim-name></p>
              <span class="sim__shine"></span>
            </div>
          </div>
        </div>
      </div>

      <div class="sim__controls">
        <p class="sim__status" data-sim-status role="status" aria-live="polite">{{ s.idle_text }}</p>
        <p class="sim__hint" data-sim-hint hidden></p>
        <div class="sim__buttons">
          <a class="btn btn--primary btn--lg" href="{{ s.cta_link }}" data-sim-cta hidden>{{ s.cta_label }} {% render 'icon', name: 'arrow' %}</a>
        </div>
        <p class="sim__stats muted small" data-sim-stats hidden></p>
      </div>

      <script type="application/json" data-sim-figures>
        [
          {%- for block in section.blocks -%}
            {
              "name": {{ block.settings.name | json }},
              "secret": {{ block.settings.secret | json }},
              "image": {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 700 | json }}{% elsif block.settings.fallback != blank %}{{ block.settings.fallback | asset_url | json }}{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>
      <script type="application/json" data-sim-strings>
        {
          "opening": {{ s.opening_text | json }},
          "got": {{ s.result_text | json }},
          "gotSecret": {{ s.secret_text | json }},
          "again": {{ s.again_button | json }},
          "standard": {{ 'sim.standard' | t | json }},
          "secret": {{ 'general.secret' | t | json }},
          "stats": {{ s.stats_text | json }}
        }
      </script>
    </unbox-sim>

    {%- if s.disclaimer != blank -%}<p class="sim__disclaimer muted small">{{ s.disclaimer }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Unboxing simulator",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "try" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Feel the ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Open one. [Right now.]" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Tap the box and see who you pull, with the real odds." },
    { "type": "text", "id": "box_series", "label": "Series name on the box", "default": "The Culling Game" },
    { "type": "text", "id": "box_art", "label": "Box window image (theme asset file)", "default": "noroi-secret.jpg" },
    { "type": "range", "id": "secret_odds", "label": "Secret odds (1 in N)", "min": 12, "max": 288, "step": 12, "default": 72 },
    { "type": "text", "id": "button", "label": "Box label (screen readers)", "default": "Open the box" },
    { "type": "text", "id": "again_button", "label": "Hint after a pull", "default": "Tap the card to open another" },
    { "type": "text", "id": "idle_text", "label": "Idle text", "default": "Tap the box to break the seal." },
    { "type": "text", "id": "opening_text", "label": "Opening text", "default": "Breaking the seal…" },
    { "type": "text", "id": "result_text", "label": "Result text", "info": "{name} is replaced by the figure.", "default": "You pulled {name}. Want the real one?" },
    { "type": "text", "id": "secret_text", "label": "Secret result text", "default": "THE SECRET. Who is it? You'll only know in a real box." },
    { "type": "text", "id": "stats_text", "label": "Stats text", "info": "{opened} and {secrets} are replaced.", "default": "Virtual boxes opened: {opened} · Secrets: {secrets}" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Open a real box" },
    { "type": "url", "id": "cta_link", "label": "CTA link", "default": "/collections/all" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "Simulation for fun only. It does not affect what's inside real boxes, which are sealed and random." }
  ],
  "blocks": [
    {
      "type": "figure",
      "name": "Figure",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Character" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Built-in image file" },
        { "type": "checkbox", "id": "secret", "label": "Secret figure", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Unboxing simulator" }]
}
{% endschema %}
