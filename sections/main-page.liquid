{%- liquid
  assign show_form = section.settings.contact_form
  if page.handle contains 'contact' or page.template_suffix contains 'contact'
    assign show_form = true
  endif
-%}
<section class="section">
  <div class="container container--narrow">
    <h1 class="h1 display page-title">{{ page.title }}</h1>
    {%- if page.content != blank -%}<div class="rte">{{ page.content }}</div>{%- endif -%}

    {%- if show_form -%}
      {%- form 'contact', class: 'contact-form', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-msg form-msg--ok" role="status">{{ 'contact.success' | t }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="form-msg form-msg--err" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <div class="contact-form__row">
            <div class="field">
              <label for="ContactName">{{ 'contact.name' | t }}</label>
              <input id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
            </div>
            <div class="field">
              <label for="ContactEmail">{{ 'contact.email' | t }} *</label>
              <input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
            </div>
          </div>
          <div class="field">
            <label for="ContactOrder">{{ 'contact.order' | t }}</label>
            <input id="ContactOrder" type="text" name="contact[order]" placeholder="#1001">
          </div>
          <div class="field">
            <label for="ContactBody">{{ 'contact.message' | t }} *</label>
            <textarea id="ContactBody" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
          </div>
          <button type="submit" class="btn btn--primary btn--lg">{{ 'contact.send' | t }}</button>
          {%- comment -%} Hide Shopify's auto-generated placeholder address {%- endcomment -%}
          {%- unless shop.email == blank or shop.email contains 'businessmail.shop' -%}
            <p class="contact-form__alt muted">{{ 'contact.or_email' | t }} <a href="mailto:{{ shop.email }}">{{ shop.email }}</a></p>
          {%- endunless -%}
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "checkbox", "id": "contact_form", "label": "Show contact form", "info": "Always shown on pages whose handle contains \"contact\".", "default": false }
  ]
}
{% endschema %}
