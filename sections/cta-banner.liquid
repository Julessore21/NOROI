{%- assign s = section.settings -%}
<section class="banner">
  <div class="banner__media">
    {%- if s.image != blank -%}
      {{ s.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750, 1200, 1800, 2400', sizes: '100vw', alt: '' }}
    {%- else -%}
      <img src="{{ 'noroi-banner-wide.jpg' | asset_url }}" alt="" loading="lazy" width="2172" height="724">
    {%- endif -%}
  </div>
  <div class="banner__content container reveal">
    <h2 class="h1 display">{{ s.heading | replace: '[', '<em>' | replace: ']', '</em>' }}</h2>
    {%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}
    {%- if s.cta_label != blank -%}
      <a class="btn btn--primary btn--lg" href="{{ s.cta_link }}">{{ s.cta_label }} {% render 'icon', name: 'arrow' %}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "CTA banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your curse is waiting." },
    { "type": "text", "id": "text", "label": "Text", "default": "Open the box. Meet whoever is inside." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Shop the drop" },
    { "type": "url", "id": "cta_link", "label": "Link", "default": "/collections/all" }
  ],
  "presets": [{ "name": "CTA banner" }]
}
{% endschema %}
