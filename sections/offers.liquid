<section class="section offers" data-scheme="{{ section.settings.scheme }}" id="{{ section.settings.anchor | default: 'shop' }}">
  <div class="container">
    <div class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h1 display">{{ section.settings.heading | replace: '[', '<em>' | replace: ']', '</em>' }}</h2>
      {%- if section.settings.text != blank -%}<p class="section-head__text">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    {%- liquid
      assign base_per_box = 0
      assign base_boxes = 999
      for block in section.blocks
        if block.settings.product != blank
          capture bb
            render 'box-count', product: block.settings.product
          endcapture
          assign bb = bb | plus: 0
          if bb < base_boxes
            assign base_boxes = bb
            assign base_per_box = block.settings.product.price | divided_by: bb
          endif
        endif
      endfor
    -%}
    <div class="offers__grid">
      {%- for block in section.blocks -%}
        <div class="offers__item{% if block.settings.featured %} offers__item--featured{% endif %} reveal" style="--d: {{ forloop.index0 | times: 80 }}ms" {{ block.shopify_attributes }}>
          {%- if block.settings.product != blank -%}
            {% render 'offer-card',
              product: block.settings.product,
              title: block.settings.title,
              badge: block.settings.badge,
              featured: block.settings.featured,
              perks: block.settings.perks,
              base_per_box: base_per_box
            %}
          {%- else -%}
            <article class="card card--placeholder{% if block.settings.featured %} card--featured{% endif %}">
              <div class="card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
              <div class="card__body">
                <h3 class="card__title">{{ 'products.pick_product' | t }}</h3>
              </div>
            </article>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="offers__note muted small">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Offers",
  "max_blocks": 4,
  "settings": [
    { "type": "select", "id": "scheme", "label": "Color scheme", "default": "dark", "options": [
      { "value": "dark", "label": "Dark" },
      { "value": "light", "label": "Light (ivory)" }
    ] },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "shop" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Choose your odds" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Three. Or the whole display." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The more you open, the lower the price per box, and the closer you get to the full set." },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "Each box is sealed and random. Duplicates are possible and the secret figure is never guaranteed." }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "Offer",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "title", "label": "Display name", "info": "Optional. Replaces the product title on this card." },
        { "type": "textarea", "id": "perks", "label": "Perks (one per line)", "info": "Keep them factual." },
        { "type": "text", "id": "badge", "label": "Badge", "info": "Keep it factual, e.g. 'Best price per box'." },
        { "type": "checkbox", "id": "featured", "label": "Highlight this offer", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Offers",
      "blocks": [
        { "type": "offer" },
        { "type": "offer", "settings": { "badge": "Discovery pack", "featured": true } },
        { "type": "offer", "settings": { "badge": "Best price per box" } }
      ]
    }
  ]
}
{% endschema %}
