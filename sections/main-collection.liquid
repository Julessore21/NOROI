<section class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</p>
      <h1 class="h1 display">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="section-head__text rte">{{ collection.description }}</div>{%- endif -%}
    </div>
    {%- paginate collection.products by section.settings.per_page -%}
      <div class="grid grid--3">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product, sizes: '(min-width: 990px) 33vw, (min-width: 600px) 50vw, 100vw' %}
        {%- else -%}
          <p class="muted">{{ 'collections.empty' | t }}</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drop 001" },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 6, "max": 48, "step": 3, "default": 24 }
  ]
}
{% endschema %}
